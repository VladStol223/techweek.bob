{
  "name": "bob-badge-ext",
  "displayName": "IBM Bob Badge Issuer",
  "description": "Install the Bob Badge Issuer mode into a workspace for IBM Bob event badge issuance",
  "version": "0.0.6",
  "publisher": "ibm-bob",
  "repository": { "type": "git", "url": "https://github.com/ibm-bob/bob-badge-ext" },
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bob-badge-sidebar",
          "title": "IBM Bob Badge Issuer",
          "icon": "assets/badge-icon.svg"
        }
      ]
    },
    "views": {
      "bob-badge-sidebar": [
        {
          "type": "webview",
          "id": "bobBadge.sidebarView",
          "name": "Badge Issuer"
        }
      ]
    },
    "commands": [
      {
        "command": "bobBadge.openPanel",
        "title": "Bob: Open Badge Issuer",
        "icon": "$(award)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bobBadge.openPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --external:vscode --platform=node --target=node18 --format=cjs --keep-names --outfile=out/extension.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
